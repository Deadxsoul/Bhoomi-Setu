PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
DB_PATH=./db/bhumi.sqlite

# Simulated OTP: when true, the OTP is returned in the API response and
# printed to the server console instead of being sent by real SMS.
# Keep this true for the hackathon demo.
OTP_DEV_MODE=true

# Google OAuth (leave blank to keep "Continue with Google" disabled in the UI)
GOOGLE_CLIENT_ID=
